<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="12dp" android:background="#E61B2026">
    <ImageView android:id="@+id/img" android:layout_width="72dp" android:layout_height="72dp"/>
    <TextView android:id="@+id/txt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:textColor="#FFFFFF" android:textSize="13sp"/>
</LinearLayout>
